POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.your-app.example.com
AUTH0_ALGORITHMS=RS256
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ENV=development

# Example agent (app/agents/) — optional, only needed to actually call
# /api/v1/agent/chat against a real model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Structured logging. LOG_FORMAT=console is human-readable (local dev);
# use LOG_FORMAT=json in any environment with a log aggregator.
LOG_LEVEL=INFO
LOG_FORMAT=console

# OpenTelemetry tracing — disabled by default. Set OTEL_ENABLED=true and run
# `docker compose --profile observability up` to send traces to the local
# Jaeger UI (http://localhost:16686).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry error tracking — disabled unless a DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
