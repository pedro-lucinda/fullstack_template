DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_db
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.your-app.example.com
AUTH0_ALGORITHMS=RS256
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ENV=development

# Example agent (app/agents/) — optional, only needed to actually call
# /api/v1/agent/chat against a real model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
